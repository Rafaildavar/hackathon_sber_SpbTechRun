# === LLM (CAILA / Qwen2.5-32B) ===
LLM_URL=https://caila.io/api/adapters/openai
LLM_MODEL=just-ai/vllm-Qwen2.5-32B-Instruct-fp8-dynamic
LLM_TOKEN=your_caila_token_here

# === Web Search ===
TAVILY_API_KEY=your_tavily_api_key_here

# === PostgreSQL ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=city_helper
# В Docker контейнере используется имя сервиса "postgres", локально - localhost:5435
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/city_helper

# === Web App ===
SECRET_KEY=your-secret-key-here

# === Telegram Bot ===
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Произвольная строка для авторизации бота в web-приложении
INTERNAL_BOT_SECRET=your-internal-secret-here
